<?xml version="1.0" encoding="utf-8"?>
<!-- The Google TV app: the same activity as the phone app (from :shared), with the TV layout,
     the Leanback launcher entry and the banner. Google Play offers it to TVs only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application android:banner="${tvBanner}">
        <!-- Read by formFactorOf(): this build is the TV app. -->
        <meta-data android:name="com.ks.jaiplayer.FORM_FACTOR" android:value="tv" />
        <activity android:name="com.ks.jaiplayer.android.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
